{
  "manifest_version": 3,
  "name": "LinkedIn Location Enricher",
  "version": "1.0.0",
  "description": "Upload a CSV of LinkedIn URLs, get back the same CSV with location/city columns filled in.",

  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "alarms"
  ],

  "host_permissions": [
    "https://www.linkedin.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn Location Enricher"
  }
}
